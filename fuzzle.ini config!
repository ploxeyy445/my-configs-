# ~/.config/fuzzel/fuzzel.ini

[main]
font=Cute Dino:size=14
prompt="❯ "
placeholder=Search apps...
icon-theme=Papirus-Dark
icons-enabled=yes
terminal=kitty -e
layer=overlay
width=36
lines=10
tabs=4
horizontal-pad=24
vertical-pad=18
inner-pad=12
line-height=26
letter-spacing=0
anchor=center
fields=filename,name,generic,keywords

[colors]
# format is RRGGBBAA (no #)
background=232136d9
text=e0def4ff
prompt=c4a7e7ff
placeholder=6e6a86ff
input=e0def4ff
match=9ccfd8ff
selection=44415acc
selection-text=e0def4ff
selection-match=9ccfd8ff
counter=6e6a86ff
border=c4a7e7ff

[border]
width=2
radius=8

[dmenu]
exit-immediately-if-empty=yes
