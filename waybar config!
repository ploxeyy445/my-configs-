/* ============================================================
   Waybar style.css : Catppuccin Mocha, floating pill edition
   ============================================================ */

@define-color rosewater #f5e0dc;
@define-color flamingo  #f2cdcd;
@define-color pink      #f5c2e7;
@define-color mauve     #cba6f7;
@define-color red       #f38ba8;
@define-color maroon    #eba0ac;
@define-color peach     #fab387;
@define-color yellow    #f9e2af;
@define-color green     #a6e3a1;
@define-color teal      #94e2d5;
@define-color sky       #89dceb;
@define-color sapphire  #74c7ec;
@define-color blue      #89b4fa;
@define-color lavender  #b4befe;
@define-color text      #cdd6f4;
@define-color subtext0  #a6adc8;
@define-color overlay0  #6c7086;
@define-color surface1  #45475a;
@define-color surface0  #313244;
@define-color base      #1e1e2e;
@define-color mantle    #181825;
@define-color crust     #11111b;

* {
    font-family: "Monocraft", "JetBrainsMono Nerd Font", monospace;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 0;
    min-height: 0;
}

/* Transparent bar so the modules float */
window#waybar {
    background: transparent;
    color: @text;
}

tooltip {
    background: @mantle;
    color: @text;
    border: 2px solid @mauve;
    border-radius: 12px;
}

tooltip label {
    color: @text;
    padding: 2px 4px;
}

/* ---------- Shared pill look ---------- */

#workspaces,
#clock,
#battery,
#cpu,
#memory,
#disk,
#network,
#wireplumber,
#mpris,
#tray,
#custom-arch,
#custom-cpucat,
#custom-power,
#custom-reboot,
#custom-shutdown {
    background: alpha(@base, 0.92);
    border-radius: 14px;
    border: 2px solid @surface0;
    margin: 6px 4px;
    padding: 2px 12px;
    transition: all 0.25s ease;
}

#clock:hover,
#battery:hover,
#cpu:hover,
#memory:hover,
#disk:hover,
#network:hover,
#wireplumber:hover,
#mpris:hover,
#custom-cpucat:hover,
#custom-arch:hover {
    background: @surface0;
}

/* ---------- Workspaces ---------- */

#workspaces {
    padding: 2px 6px;
    margin-left: 0;
    border-color: @surface1;
}

#workspaces button {
    padding: 0 8px;
    margin: 2px 2px;
    color: @overlay0;
    background: transparent;
    border-radius: 10px;
    transition: all 0.25s ease;
}

#workspaces button.empty {
    color: @surface1;
}

#workspaces button:hover {
    background: @surface0;
    color: @text;
    box-shadow: none;
}

#workspaces button.active,
#workspaces button.empty.active {
    background: @mauve;
    color: @crust;
}

#workspaces button.urgent {
    background: @red;
    color: @crust;
}

/* Reset the default hover underline so it doesn't fight the pills */
button:hover {
    background: inherit;
    box-shadow: none;
}

/* ---------- Modules ---------- */

#clock {
    color: @sky;
    border-color: alpha(@sky, 0.5);
}

#cpu {
    color: @green;
    border-color: alpha(@green, 0.5);
}

#cpu.warning {
    color: @yellow;
    border-color: @yellow;
}

#cpu.critical {
    color: @red;
    border-color: @red;
}

#memory {
    color: @mauve;
    border-color: alpha(@mauve, 0.5);
}

#memory.warning {
    color: @yellow;
    border-color: @yellow;
}

#memory.critical {
    color: @red;
    border-color: @red;
}

#disk {
    color: @peach;
    border-color: alpha(@peach, 0.5);
}

#network {
    color: @blue;
    border-color: alpha(@blue, 0.5);
}

#network.disconnected,
#network.disabled {
    color: @crust;
    background: @red;
    border-color: @red;
}

#wireplumber {
    color: @pink;
    border-color: alpha(@pink, 0.5);
}

#wireplumber.muted {
    color: @red;
    border-color: @red;
}

#mpris {
    color: @teal;
    border-color: alpha(@teal, 0.5);
}

#mpris.paused,
#mpris.stopped {
    color: @overlay0;
    border-color: @surface0;
}

#battery {
    color: @lavender;
    border-color: alpha(@lavender, 0.5);
}

#battery.charging,
#battery.plugged {
    color: @green;
    border-color: @green;
}

#battery.warning:not(.charging) {
    color: @yellow;
    border-color: @yellow;
}

#battery.critical:not(.charging) {
    color: @crust;
    background: @red;
    border-color: @red;
    animation: blink 0.8s steps(2) infinite alternate;
}

@keyframes blink {
    to {
        background: @mantle;
        color: @red;
    }
}

#tray {
    padding: 2px 10px;
    border-color: @surface1;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background: @red;
    border-radius: 10px;
}

/* Waycat CPU cat */
#custom-cpucat {
    font-family: "Waycat", monospace;
    font-size: 20px;
    color: @rosewater;
    border-color: alpha(@flamingo, 0.5);
    padding-left: 10px;
    padding-right: 10px;
}

/* Separators: hidden (GTK CSS has no display:none, so shrink them to nothing) */
#custom-sep {
    color: transparent;
    background: transparent;
    font-size: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    border: none;
}

/* Outer margins */
.modules-right > widget:last-child > * {
    margin-right: 8px;
}

/* Arch logo */
#custom-arch {
    color: @sapphire;
    border-color: alpha(@sapphire, 0.5);
    font-size: 18px;
    padding: 2px 14px 2px 8px;
    margin-left: 8px;
}

/* ---------- Power menu ---------- */

#custom-power {
    color: @red;
    border-color: alpha(@red, 0.5);
}

#custom-power:hover {
    background: @red;
    color: @crust;
}

#custom-reboot {
    color: @yellow;
    border-color: alpha(@yellow, 0.5);
}

#custom-reboot:hover {
    background: @yellow;
    color: @crust;
}

#custom-shutdown {
    color: @red;
    border-color: alpha(@red, 0.5);
}

#custom-shutdown:hover {
    background: @red;
    color: @crust;
}
