@import "colors.css";


/* =====================================================================

   Waybar - Catppuccin Mocha - floating pills

   ===================================================================== */


@define-color accent        @lavender;

@define-color clock_color   @lavender;

@define-color audio_color   @pink;

@define-color media_color   @mauve;

@define-color network_color @teal;

@define-color battery_color @green;


/* ---------- Base ---------- */


* {

    font-family: "Cute Dino", "JetBrainsMono Nerd Font", monospace;

    font-size: 14px;

    font-weight: bold;

    border: none;

    border-radius: 0;

    box-shadow: none;

    text-shadow: none;

    min-height: 0;

}


window#waybar {

    background: transparent;

    color: @text;

}


.modules-left  { margin-left: 5px; }

.modules-right { margin-right: 5px; }


tooltip {

    background: alpha(@mantle, 0.96);

    border: 1px solid alpha(@accent, 0.5);

    border-radius: 14px;

}


tooltip label {

    color: @text;

    padding: 4px 6px;

}


/* ---------- Individual Standalone Pills ---------- */


#workspaces, #clock, #wireplumber, #tray, #network, #battery {

    color: @accent;

    background: alpha(@base, 0.85);

    border: 1px solid alpha(currentColor, 0.3);

    border-radius: 18px;

    margin: 6px 3px;

    padding: 2px 14px;

    transition: all 0.25s ease;

}




/* ---------- Module colors ---------- */


#clock               { color: @clock_color; }

#cpu, #memory, #disk { color: @accent; }

#wireplumber         { color: @audio_color; }


#network             { color: @network_color; }

#battery             { color: @battery_color; }


/* ---------- States ---------- */


#cpu.warning, #memory.warning, #disk.warning,

#battery.warning:not(.charging) { color: @yellow; }


#cpu.critical, #memory.critical, #disk.critical { color: @red; }


#wireplumber.muted { color: @red; }



/* ---------- Workspaces ---------- */


#workspaces { padding: 2px 4px; }


#workspaces button {

    padding: 3px 10px 0;

    margin: 2px 1px;

    font-size: 26px;

    font-family: "Cute Dino", "JetBrainsMono Nerd Font", monospace;

    color: @overlay0;

    background: transparent;

    border-radius: 14px;

    transition: all 0.3s ease;

}


#workspaces button:hover {

    background: @surface0;

    color: @text;

}


/* the active workspace stretches into a filled pill */

#workspaces button.active {

    background: @accent;

    color: @crust;

    padding: 3px 10px 0;

}


#workspaces button.urgent {

    background: @red;

    color: @crust;

}


/* ---------- Stats Strip (Fused Capsule) ---------- */


#cpu, #memory, #disk {

    background: alpha(@base, 0.85);

    border: 1px solid alpha(currentColor, 0.3);

    margin-top: 6px;

    margin-bottom: 6px;

    padding: 2px 14px;

    transition: all 0.25s ease;

}


#cpu:hover, #memory:hover, #disk:hover {

    background: @surface0;

    border-color: alpha(currentColor, 0.8);

}


#cpu {

    margin-left: 3px;

    margin-right: 0;

    border-right: none;

    border-radius: 18px 0 0 18px;

}


#memory {

    margin-left: 0;

    margin-right: 0;

    border-left: none;

    border-right: none;

    border-radius: 0;

}


#disk {

    margin-left: 0;

    margin-right: 3px;

    border-left: none;

    border-radius: 0 18px 18px 0;

}


/* ---------- Tray ---------- */


#tray { padding: 2px 10px; }

#tray > .passive { -gtk-icon-effect: dim; }

#tray > .needs-attention {

    -gtk-icon-effect: highlight;

    background: @red;

    border-radius: 12px;

}

/* ---------- Power button ---------- */

#custom-power {

    font-family: "JetBrainsMono Nerd Font", monospace;

    font-size: 16px;

    color: @red;

    background: alpha(@base, 0.85);

    border: 1px solid alpha(currentColor, 0.3);

    border-radius: 18px;

    margin: 6px 3px;

    padding: 2px 14px;

    transition: all 0.25s ease;

}

#custom-power:hover {

    background: @surface0;

    border-color: alpha(currentColor, 0.8);

}


#workspaces button label { font-size: 16px; }
